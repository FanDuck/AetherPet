# ==============================================================================
# AetherPet - 开源 3D AI 宠物框架 环境变量示例
# 提示：所有配置也可直接在网页端右上角「引擎配置面板」中可视化填写并保存！
# ==============================================================================

# 1. 大语言模型 (LLM) 默认服务端密钥 (可选，前端未填 API Key 时自动回退使用)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 常见大模型 Base URL 参考：
# - DeepSeek 官方: https://api.deepseek.com/v1 (模型: deepseek-chat / deepseek-reasoner)
# - OpenAI 官方: https://api.openai.com/v1 (模型: gpt-4o-mini / gpt-4o)
# - 硅基流动 SiliconFlow: https://api.siliconflow.cn/v1 (模型: deepseek-ai/DeepSeek-V3)
# - 通义千问 DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1 (模型: qwen-plus)
# - 智谱 GLM: https://open.bigmodel.cn/api/paas/v4 (模型: glm-4-flash)
# - 本地 Ollama: http://localhost:11434/v1 (模型: qwen2.5:7b)

# 2. 配音引擎 (TTS) 默认服务端密钥 (可选)
TTS_API_KEY=
TTS_BASE_URL=https://api.siliconflow.cn/v1
ELEVENLABS_API_KEY=
FISH_AUDIO_API_KEY=
